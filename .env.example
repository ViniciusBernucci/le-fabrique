NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://le_fabrique:le_fabrique_dev@127.0.0.1:5432/le_fabrique?schema=public
REDIS_URL=redis://127.0.0.1:6379
VITE_API_URL=/api
ADMIN_API_TOKEN=local-development-token-change-me-0001
WORKER_API_TOKEN=local-worker-token-change-me-0000001
CONTROL_API_URL=http://127.0.0.1:3000/api
WORKER_ID=00000000-0000-4000-8000-000000000001
WORKER_NAME=local-worker
WORKER_HEARTBEAT_INTERVAL_MS=5000
# Real ticket execution stays off until the worker host and provider CLIs are verified.
WORKER_EXECUTION_ENABLED=false
WORKER_LEASE_DURATION_MS=90000
# Optional private provider root: provision outside the repository before UI login/status.
# WORKER_PROVIDER_ROOT=/absolute/private/providers

# Provisionamento idempotente local: npm run providers:setup (depois reinicie npm run dev).
# Claude: npm run providers:login -- claude-default, após salvar/habilitar essa conta no painel.
# WORKER_CODEX_BINARY=/absolute/path/to/codex
# WORKER_CLAUDE_BINARY=/absolute/path/to/claude

# WORKER_ANTIGRAVITY_BINARY=/absolute/path/to/agy
