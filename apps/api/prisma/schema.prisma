generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  DRAFT
  READY
  WAITING_WORKER
  RUNNING
  VALIDATING
  REVIEW
  DOCS
  AWAITING_HUMAN
  DONE
  WAITING_PROVIDER
  PAUSED_LIMIT
  PAUSED_RESOURCE
  BLOCKED_RECOVERY
  AUTH_REQUIRED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum WorkerStatus {
  ONLINE
  OFFLINE
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  repoUrl   String   @map("repo_url")
  baseRef   String   @map("base_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tickets   Ticket[]

  @@map("projects")
}

model Ticket {
  id                 String       @id @default(uuid()) @db.Uuid
  projectId          String       @db.Uuid @map("project_id")
  title              String
  objective          String
  acceptanceCriteria Json         @map("acceptance_criteria")
  status             TicketStatus @default(DRAFT)
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@map("tickets")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  aggregateId String       @db.Uuid @map("aggregate_id")
  eventType   String       @map("event_type")
  deduplicationKey String   @unique @map("deduplication_key")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  publishedAt DateTime?    @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model WorkerIdentity {
  id              String       @id @db.Uuid
  name            String
  status          WorkerStatus @default(ONLINE)
  capabilities    Json
  os              String
  arch            String
  nodeVersion     String       @map("node_version")
  lastHeartbeatAt DateTime     @map("last_heartbeat_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status, lastHeartbeatAt])
  @@map("worker_identities")
}
