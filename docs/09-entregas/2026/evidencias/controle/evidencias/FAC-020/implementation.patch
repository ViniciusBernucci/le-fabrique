+            Esta é uma prévia da central de controle. Os dados desta área são simulados; a
+            integração será disponibilizada em uma próxima etapa.
+          </p>
+        )}
+        <form method="dialog">
+          <button type="submit">Voltar ao painel</button>
+        </form>
+      </dialog>
+    </div>
+  );
+}
