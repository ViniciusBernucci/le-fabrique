+}
+.tasks-shell input:focus-visible,
+.tasks-shell select:focus-visible,
+.tasks-shell textarea:focus-visible {
+  border-color: var(--hud-cyan);
+  box-shadow: 0 0 0 3px var(--hud-input-focus);
+}
+.tasks-view > div {
+  border: 1px solid var(--hud-line-soft);
+  padding: 3px;
+  border-radius: var(--hud-radius);
+}
+.tasks-view button {
+  border-color: transparent;
+  background: transparent;
+  box-shadow: none;
+}
+.tasks-view button[aria-pressed="true"] {
+  background: var(--hud-selected);
+  color: var(--hud-text-strong);
+}
+.tasks-column {
+  --stage-tone: var(--hud-idle);
+  border-top: 2px solid var(--stage-tone);
+}
+.tasks-column h2 {
+  font: 500 11px var(--hud-font-mono);
+  color: var(--stage-tone);
+}
+.tasks-column h2 > i {
+  background: var(--stage-tone);
+  box-shadow: var(--hud-glow) var(--stage-tone);
+}
+.task-card {
+  --stage-tone: var(--hud-idle);
+  background: var(--hud-surface-solid);
+  border-color: var(--hud-line-soft);
+  border-left: 3px solid var(--stage-tone);
+}
+.task-card:hover {
+  border-color: var(--stage-tone);
+}
+[data-task-stage="Backlog"] {
+  --stage-tone: var(--hud-idle);
+}
+[data-task-stage="Pronto"] {
+  --stage-tone: var(--hud-cyan);
+}
+[data-task-stage="Em andamento"] {
+  --stage-tone: var(--hud-blue);
+}
+[data-task-stage="Revisão"] {
+  --stage-tone: var(--hud-violet);
+}
+[data-task-stage="QA"] {
+  --stage-tone: var(--hud-violet);
+}
+[data-task-stage="Documentação"] {
+  --stage-tone: var(--hud-violet);
+}
+[data-task-stage="Aceite"] {
+  --stage-tone: var(--hud-rose);
+}
+[data-task-stage="Concluído"] {
+  --stage-tone: var(--hud-teal);
+}
+[data-task-stage="Bloqueado"] {
+  --stage-tone: var(--hud-amber);
+}
+.task-card-meta,
+.task-card-footer,
+.task-phase,
+.task-priority,
+.tasks-history time {
+  font-family: var(--hud-font-mono);
+}
+.task-title {
+  font-family: var(--hud-font-ui);
+  font-weight: 700;
+  box-shadow: none;
+}
+.task-title:hover {
+  background: transparent;
+  box-shadow: none;
+}
+.priority-2 {
+  background: color-mix(in srgb, var(--hud-amber) 10%, transparent);
+  color: var(--hud-amber);
+}
+.priority-3 {
+  background: color-mix(in srgb, var(--hud-rose) 10%, transparent);
+  color: var(--hud-danger-text);
+}
+.task-column-empty,
+.tasks-empty {
+  border: 1px dashed var(--hud-line-strong);
+  border-radius: var(--hud-radius);
+  padding: 22px 14px;
+  text-align: center;
+}
+.task-column-empty::before,
+.tasks-empty::before {
+  content: "◎";
+  display: block;
+  color: var(--hud-cyan);
+  font-size: 32px;
+  line-height: 1.3;
+  margin-bottom: 8px;
+}
+.tasks-message {
+  border: 1px solid color-mix(in srgb, var(--hud-amber) 35%, transparent);
+  border-left: 3px solid var(--hud-amber);
+  border-radius: var(--hud-radius);
+  padding: 10px 12px;
+  background: color-mix(in srgb, var(--hud-amber) 6%, transparent);
+}
+
+.task-stage {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-left: 6px;
+  padding: 3px 8px;
+  font: 600 10px var(--hud-font-mono);
+  color: var(--stage-tone);
+  border: 1px solid color-mix(in srgb, var(--stage-tone) 40%, transparent);
+  border-radius: var(--hud-radius-sm);
+  background: color-mix(in srgb, var(--stage-tone) 8%, transparent);
+}
+.task-stage::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--stage-tone);
+}
