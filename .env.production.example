POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://le_fabrique:replace-with-a-long-random-password@postgres:5432/le_fabrique?schema=public
ADMIN_API_TOKEN=replace-with-an-independent-random-admin-token
WORKER_API_TOKEN=replace-with-an-independent-random-worker-token
WORKER_ID=00000000-0000-4000-8000-000000000001
WORKER_NAME=le-fabrique-worker
WORKER_HEARTBEAT_INTERVAL_MS=5000
# Keep false in examples. Enable only after manual worker-host and provider preflight.
WORKER_EXECUTION_ENABLED=false
WORKER_EXECUTION_ROOT=/var/lib/le-fabrique-worker/execution
WORKER_CHECKOUT_ROOT=/var/lib/le-fabrique-worker/checkouts
WORKER_REPOSITORY_HOSTS=
WORKER_CODEX_BINARY=/usr/bin/codex
WORKER_CLAUDE_BINARY=/usr/bin/claude
WORKER_LEASE_DURATION_MS=90000
