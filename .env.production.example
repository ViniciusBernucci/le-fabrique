POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://le_fabrique:replace-with-a-long-random-password@postgres:5432/le_fabrique?schema=public
ADMIN_API_TOKEN=replace-with-an-independent-random-admin-token
WORKER_API_TOKEN=replace-with-an-independent-random-worker-token
# Host worker configuration: infrastructure/systemd/worker.env.example

# Configure privately before enabling account email / MFA / billing. Never put real keys in Git.
# ACCOUNT_DATA_ENCRYPTION_KEY=
# ACCOUNT_PUBLIC_URL=https://your-web-origin/
ACCOUNT_SMTP_ENABLED=false
# ACCOUNT_SMTP_HOST=
# ACCOUNT_SMTP_PORT=587
# ACCOUNT_SMTP_SECURE=false
# ACCOUNT_SMTP_USER=
# ACCOUNT_SMTP_PASSWORD=
# ACCOUNT_EMAIL_FROM=
ACCOUNT_STRIPE_ENABLED=false
# ACCOUNT_STRIPE_SECRET_KEY=
# ACCOUNT_STRIPE_WEBHOOK_SECRET=
# ACCOUNT_PLAN_CATALOG=
