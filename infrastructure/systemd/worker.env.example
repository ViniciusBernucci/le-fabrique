# Copy outside the repository to /etc/le-fabrique/worker.env and fill manually.
# Do not commit real credentials or reuse a token from another environment.
NODE_ENV=production
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=1
CONTROL_API_URL=http://127.0.0.1:3000/api
WORKER_API_TOKEN=
WORKER_ID=
WORKER_NAME=le-fabrique-worker-vps
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_EXECUTION_ENABLED=false
WORKER_LEASE_DURATION_MS=90000
WORKER_EXECUTION_ROOT=/var/lib/le-fabrique-worker/execution
WORKER_CHECKOUT_ROOT=/var/lib/le-fabrique-worker/checkouts
# Pre-provision as canonical directory, owned by service user, mode 0700.
# Account IDs come from the UI; no auth cache is copied automatically.
WORKER_PROVIDER_ROOT=/var/lib/le-fabrique-worker/providers
WORKER_REPOSITORY_HOSTS=
WORKER_CODEX_BINARY=/usr/bin/codex
WORKER_CLAUDE_BINARY=/usr/bin/claude
WORKER_ANTIGRAVITY_BINARY=/usr/bin/agy
# Antigravity requires gnome-keyring; its D-Bus/keyring session is private per account.
# Fill after provisioning: /run/user/<worker-uid> and unix:path=/run/user/<worker-uid>/bus.
# A system unit's %U refers to the manager UID (0), not User=le-fabrique-worker.
XDG_RUNTIME_DIR=
DBUS_SESSION_BUS_ADDRESS=
