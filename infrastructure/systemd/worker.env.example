# Copy outside the repository to /etc/le-fabrique/worker.env and fill manually.
# Do not commit real credentials or reuse a token from another environment.
NODE_ENV=production
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=1
CONTROL_API_URL=http://127.0.0.1:3000/api
WORKER_API_TOKEN=
WORKER_ID=
WORKER_NAME=le-fabrique-worker-vps
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_CHECKOUT_ROOT=/var/lib/le-fabrique-worker/checkouts
WORKER_REPOSITORY_HOSTS=
